{
    "name": "nightworksio/mutation-gate",
    "description": "The packages the gate's keyed commands, deliver and fetch, run on: the package's own and async-aws/s3, so the action and the reusable workflow install them from a lock in the jobs that hold a credential.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ext-sodium": "*",
        "ext-tokenizer": "*",
        "ext-zlib": "*",
        "composer-runtime-api": "^2.2",
        "async-aws/core": "^1.30",
        "async-aws/s3": "^3",
        "fidry/cpu-core-counter": "^1.3",
        "nikic/php-parser": "^5.9",
        "psr/clock": "^1.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-client-contracts": "^3.5",
        "symfony/process": "^7.4.5 || ^8.0.5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "NightWorksIO\\MutationGateDefault\\": "plugins/default/src/",
            "NightWorksIO\\MutationGateLaravel\\": "plugins/laravel/src/",
            "NightWorksIO\\MutationGateSecurity\\": "plugins/security/src/",
            "NightWorksIO\\MutationGateSymfony\\": "plugins/symfony/src/",
            "NightWorksIO\\MutationGate\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.12"
        },
        "sort-packages": true
    }
}
