// markdownlint, as the lemonfiber estate configures it, so a document reads
// the same way in every repository its maintainer works in.
//
// Each entry only relaxes a default.
{
  // Prose is wrapped by the author, not by a column count.
  "MD013": false,
  // Shell examples keep their `$` prompt; it is how the command is read aloud.
  "MD014": false,
  // The same sub-heading recurs under different parents ("Requirements").
  "MD024": { "siblings_only": true },
  // Feature docs carry a frontmatter `title:` and a separate `# ID — Title`
  // heading; don't count the frontmatter field as a second H1.
  "MD025": { "front_matter_title": "" },
  // Ordered lists restart per section rather than running on.
  "MD029": false,
  // READMEs centre their header with inline HTML.
  "MD033": false,
  // Bold lead-ins are emphasis, not headings.
  "MD036": false,
  // Fenced output blocks have no language to declare.
  "MD040": false,
  // A centred logo block precedes the first heading.
  "MD041": false,
  // Tables are written to be read as text, not aligned by a formatter.
  "MD060": false
}
