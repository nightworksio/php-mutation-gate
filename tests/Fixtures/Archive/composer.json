{
    "name": "nightworksio/mutation-gate-archive-fixture",
    "description": "The library the gate's PHAR judges in its smoke suite with Infection, tested by PHPUnit, with no copy of the gate installed.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "infection/infection": "~0.35.0",
        "phpunit/phpunit": "^13.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Library\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    }
}
