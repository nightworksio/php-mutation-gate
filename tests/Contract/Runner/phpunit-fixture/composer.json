{
    "name": "nightworksio/mutation-gate-phpunit-fixture",
    "description": "The PHPUnit runner's libraries, beside the gate's source: in library/, the code every runner's contract mutates, and here, the quirks of a project's tests, sharing one vendor directory.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "phpunit/php-code-coverage": "^14.3",
        "phpunit/phpunit": "^13.2.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Beside\\": "library/beside/",
            "Library\\": "library/src/",
            "NightWorksIO\\MutationGate\\": "../../../../src/",
            "Quirks\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": [
                "library/tests/",
                "tests/"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
