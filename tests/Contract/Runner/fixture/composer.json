{
    "name": "nightworksio/mutation-gate-runner-fixture",
    "description": "The library the runner contract suite mutates, with the Pest plugin of the package it tests.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-mutate": "^5.0"
    },
    "conflict": {
        "pestphp/pest-plugin-mutate": "<5.0.2 || >5.0.2"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Legacy\\": "legacy/",
            "Library\\": "src/",
            "NightWorksIO\\MutationGate\\": "../../../../src/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "pest": {
            "plugins": [
                "NightWorksIO\\MutationGate\\Adapter\\Pest\\Plugin"
            ]
        }
    }
}
