{
    "name": "nightworksio/mutation-gate-runner-fixture",
    "description": "The library the runner contract suite mutates, with the Pest plugin of the package it tests and the mutator the contract registers.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-mutate": "^5.0",
        "phpunit/php-code-coverage": "^14.3"
    },
    "conflict": {
        "pestphp/pest": "<5.1",
        "pestphp/pest-plugin-mutate": "<5.0.2 || >5.0.2",
        "phpunit/phpunit": "<12.5.8 || >=12.5.21 <12.5.22 || >=13.1.5 <13.1.6",
        "symfony/yaml": "<7.4.12 || >=8.0 <8.0.12"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Library\\": "src/",
            "NightWorksIO\\MutationGate\\": "../../../../src/",
            "NightWorksIO\\MutationGate\\Tests\\Contract\\Runner\\Mutators\\": "../Mutators/"
        },
        "files": [
            "src/Unexecutable/functions.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "pest": {
            "plugins": [
                "NightWorksIO\\MutationGate\\Adapter\\Pest\\Plugin"
            ]
        }
    }
}
