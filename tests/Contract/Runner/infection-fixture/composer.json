{
    "name": "nightworksio/mutation-gate-infection-fixture",
    "description": "The library the runner contract suite mutates with Infection, the same as the Pest fixture's, tested by PHPUnit, with the package it tests and the mutator the contract registers.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "infection/infection": "~0.35.0",
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "phpunit/phpunit": "<12.5.8 || >=12.5.21 <12.5.22 || >=13.1.5 <13.1.6"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Beside\\": "beside/",
            "Library\\": "src/",
            "NightWorksIO\\MutationGate\\": "../../../../src/",
            "NightWorksIO\\MutationGate\\Tests\\Contract\\Runner\\Mutators\\": "../Mutators/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/marks.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    }
}
