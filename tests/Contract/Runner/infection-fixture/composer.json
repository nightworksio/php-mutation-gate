{
    "name": "nightworksio/mutation-gate-infection-fixture",
    "description": "The library the runner contract suite mutates with Infection, the same as the Pest fixture's, tested by PHPUnit.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "infection/infection": "~0.35.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Library\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    }
}
