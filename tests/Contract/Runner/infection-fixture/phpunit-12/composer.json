{
    "name": "nightworksio/mutation-gate-infection-fixture-phpunit-12",
    "description": "The Infection library one level up, tested by PHPUnit 12, installed into its vendor directory.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "infection/infection": "~0.35.0",
        "phpunit/phpunit": "^12.0"
    },
    "conflict": {
        "phpunit/phpunit": "<12.5.8 || >=12.5.21 <12.5.22 || >=13.1.5 <13.1.6"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Library\\": "../src/",
            "NightWorksIO\\MutationGate\\": "../../../../../src/",
            "NightWorksIO\\MutationGate\\Tests\\Contract\\Runner\\Mutators\\": "../../Mutators/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "../tests/"
        },
        "files": [
            "../tests/marks.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true,
        "vendor-dir": "../vendor"
    }
}
