includes:
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

parameters:
    level: 9
    paths:
        - src
    excludePaths:
        - src/Excluded.php
    bootstrapFiles:
        - bootstrap.php
    disallowedFunctionCalls:
        -
            function: 'getenv()'
            message: 'the environment is read where the project is wired, alone'
            allowIn:
                - src/Composition/*
