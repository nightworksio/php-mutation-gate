#!/bin/sh
# Say now what CI will say later about this commit message.
#
# `commitlint` wants a conventional subject. It needs no network or build to
# know, and finding out here costs a second instead of a round trip. The
# pattern is the one .github/scripts/commit_lint.py applies; where the two
# disagree, the script is right and this is wrong.
#
# A `Spec:` trailer is optional. Where a commit has one, every number it names
# must be a decision record in .docs/decisions.

set -eu

message=$1

# A merge or a revert is written by git and is exempt, as it is in CI.
subject=$(sed -n '1p' "$message")
case "$subject" in
Merge\ * | Revert\ * | fixup!* | squash!*) exit 0 ;;
esac

# Comment lines are not part of the message.
body=$(grep -v '^#' "$message" || true)

faults=""

types="feat|fix|docs|refactor|test|chore|ci|perf|build|style|revert"
if ! printf '%s\n' "$subject" | grep -qE "^($types)(\([a-z0-9.-]+\))?!?: .+"; then
	faults="${faults}  the subject is not conventional: ${subject}
      types: $(printf '%s' "$types" | tr '|' ' ')
      e.g.  feat(cli): refuse a config with no tree
"
fi

# Every number a `Spec:` trailer names, each of which must be a decision record.
cited=$(printf '%s\n' "$body" | sed -n 's/^[ \t]*Spec:[ \t]*//p')
for number in $(printf '%s\n' "$cited" | tr ',' ' '); do
	if ! printf '%s' "$number" | grep -qE '^[0-9]{4}$'; then
		faults="${faults}  Spec: ${number} is not a four-digit decision number, e.g. Spec: 0006
"
		continue
	fi
	found=no
	for record in .docs/decisions/"$number"-*.md; do
		[ -f "$record" ] && found=yes
	done
	if [ "$found" = no ]; then
		faults="${faults}  Spec: ${number} names no decision record in .docs/decisions
"
	fi
done

if [ -n "$faults" ]; then
	echo "commit-msg: this is what CI would have said." >&2
	echo "" >&2
	printf '%s' "$faults" >&2
	echo "  Nothing is lost: the message is in .git/COMMIT_EDITMSG." >&2
	exit 1
fi

exit 0
