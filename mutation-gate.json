{
    "$schema": "resources/mutation-gate.schema.json",
    "runner": {
        "use": "pest",
        "memory": "2G"
    },
    "ci": {
        "check": "mutation verdict",
        "trustMergedPullRequests": true
    },
    "trees": [
        {
            "path": "src",
            "exclude": [
                "src/Adapter/Pest/Bridged.php",
                "src/Adapter/Pest/Grouping/HoldsGroups.php",
                "src/Adapter/Pest/Order/Option.php",
                "src/Adapter/Pest/Order/Reordering.php",
                "src/Adapter/Pest/Order/Seed.php",
                "src/Adapter/Pest/Plugin.php",
                "src/Adapter/Pest/Recording/Guard.php",
                "src/Adapter/Pest/Recording/Killers.php",
                "src/Adapter/Pest/Recording/LastError.php",
                "src/Adapter/Pest/Recording/Naming.php",
                "src/Adapter/Pest/Recording/OnFailed.php",
                "src/Adapter/Pest/Recording/Placed.php",
                "src/Adapter/Pest/Recording/RanTests.php",
                "src/Adapter/Pest/Recording/ReplayStop.php",
                "src/Adapter/Pest/Recording/TimedTests.php",
                "src/Adapter/Pest/SchemaSwitch.php",
                "src/Adapter/Pest/ServedClasses.php",
                "src/Adapter/Native/MutantFile.php",
                "src/Adapter/Runtime/ForkedChild.php",
                "src/Cli/PestPlugin.php",
                "src/Core/Mutant/OrderDigest.php"
            ]
        },
        {
            "path": "plugins/default/src"
        },
        {
            "path": "plugins/laravel/src"
        },
        {
            "path": "plugins/symfony/src"
        },
        {
            "path": "plugins/security/src"
        }
    ],
    "baseline": {
        "improvement": "report"
    },
    "reach": {
        "everything": [
            "src/Adapter/Pest/Warm/**",
            "src/Adapter/Pest/ByName.php",
            "src/Adapter/Pest/Recording/**",
            "src/Adapter/Pest/Grouping/**",
            "src/Adapter/Pest/Order/**",
            "src/Adapter/Pest/Plugin.php",
            "src/Adapter/Pest/Bridged.php",
            "src/Adapter/Pest/Patch.php",
            "src/Adapter/Pest/Patching.php",
            "src/Cli/PestPlugin.php",
            "src/Adapter/Runtime/ForkedChild.php",
            "bin/mutation-gate-pest-client",
            "bin/mutation-gate-pest-worker",
            "src/Core/Runner/MutantLimit.php"
        ],
        "fixtures": [
            "tests/Contract/Runner/codeception-fixture",
            "tests/Contract/Runner/constants",
            "tests/Contract/Runner/crash",
            "tests/Contract/Runner/fixture",
            "tests/Contract/Runner/hang",
            "tests/Contract/Runner/heavy",
            "tests/Contract/Runner/infection-fixture",
            "tests/Contract/Runner/interceptor",
            "tests/Contract/Runner/override",
            "tests/Contract/Runner/phpspec-fixture",
            "tests/Contract/Runner/phpunit-fixture",
            "tests/Contract/Runner/reach",
            "tests/Contract/Runner/stall",
            "tests/Contract/Runner/testo-fixture",
            "tests/Contract/Runner/twins",
            "tests/Contract/StaticChecker/fixture",
          "tests/Fixtures/*"
        ],
        "lockPackages": [
            "brianium/paratest",
            "ergebnis/phpstan-rules",
            "nikic/php-parser",
            "pestphp/*",
            "phpstan/*",
            "phpunit/*",
            "sebastian/*",
            "shipmonk/phpstan-rules",
            "spaze/phpstan-disallowed-calls",
            "staabm/side-effects-detector",
            "symfony/process",
            "tomasvotruba/*"
        ]
    },
    "pest": {
        "patch": true
    },
    "shards": {
        "max": "learned"
    },
    "timeouts": {
        "seconds": "learned",
        "multiple": "learned"
    },
    "staticCheck": {
        "config": "phpstan/mutants.neon"
    },
    "flaky": {
        "confirmSurvivors": false
    },
    "tests": {
        "suites": ["Unit", "Plugins"],
        "holding": ["Process", "Contract"]
    },
    "contexts": {
        "pr": {
            "run": {
                "failFast": "cancel"
            }
        }
    }
}
