{
    "$schema": "resources/mutation-gate.schema.json",
    "runner": {
        "use": "pest",
        "memory": "2G"
    },
    "trees": [
        {
            "path": "src",
            "exclude": [
                "src/Adapter/Pest/Bridged.php",
                "src/Adapter/Pest/Grouping/HoldsGroups.php",
                "src/Adapter/Pest/Order/Option.php",
                "src/Adapter/Pest/Order/Reordering.php",
                "src/Adapter/Pest/Order/Seed.php",
                "src/Adapter/Pest/Plugin.php",
                "src/Adapter/Pest/Recording/Guard.php",
                "src/Adapter/Pest/Recording/Killers.php",
                "src/Adapter/Pest/Recording/Naming.php",
                "src/Adapter/Pest/Recording/OnFailed.php",
                "src/Adapter/Pest/Recording/Placed.php",
                "src/Adapter/Pest/Recording/RanTests.php",
                "src/Adapter/Pest/Recording/ReplayStop.php",
                "src/Adapter/Native/MutantFile.php",
                "src/Cli/PestPlugin.php",
                "src/Core/Mutant/OrderDigest.php"
            ]
        },
        {
            "path": "plugins/default/src"
        },
        {
            "path": "plugins/laravel/src"
        },
        {
            "path": "plugins/symfony/src"
        },
        {
            "path": "plugins/security/src"
        }
    ],
    "baseline": {
        "improvement": "report"
    },
    "reach": {
        "lockPackages": [
            "brianium/paratest",
            "ergebnis/phpstan-rules",
            "nikic/php-parser",
            "pestphp/*",
            "phpstan/*",
            "phpunit/*",
            "sebastian/*",
            "shipmonk/phpstan-rules",
            "spaze/phpstan-disallowed-calls",
            "staabm/side-effects-detector",
            "symfony/process",
            "tomasvotruba/*"
        ]
    },
    "pest": {
        "patch": true
    },
    "shards": {
        "max": 20
    },
    "timeouts": {
        "seconds": 30
    },
    "staticCheck": {
        "config": "phpstan/mutants.neon"
    },
    "flaky": {
        "confirmSurvivors": false
    },
    "tests": {
        "suites": ["Unit", "Plugins"],
        "holding": ["Process", "Contract"]
    },
    "ignores": {
        "entries": [
            {
                "mutant": "96b0928628e8",
                "reason": "Equivalent: whether PCRE compiles a pattern does not depend on the subject it is matched against, so any text in place of '' gives the same answer.",
                "expires": "2027-10-13"
            },
            {
                "mutant": "46649b4dd3ea",
                "reason": "Equivalent: reproduce declares its id argument required, so Symfony refuses a run without one before the command's code runs, and the id it reads is always a string; the text in place of a missing one is never read.",
                "expires": "2027-10-21"
            },
            {
                "mutant": "a6a05d04da17",
                "reason": "Equivalent: TestFile::closingOf compares token indices, and a brace's index never equals the index of the class keyword, so > and >= pick the same brace.",
                "expires": "2027-10-11"
            }
        ]
    }
}
