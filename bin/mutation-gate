#!/usr/bin/env php
<?php

declare(strict_types=1);

use NightWorksIO\MutationGate\Cli\Gate;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Console\Output\ConsoleOutput;

$autoload = array_key_exists('_composer_autoload_path', $GLOBALS) && is_string($GLOBALS['_composer_autoload_path'])
    ? $GLOBALS['_composer_autoload_path']
    : sprintf('%s/vendor/autoload.php', dirname(__DIR__));
require $autoload;

$output = new ConsoleOutput();

exit(Gate::in((string) getcwd(), dirname($autoload))->run(new ArgvInput(), $output, $output->getErrorOutput()));
