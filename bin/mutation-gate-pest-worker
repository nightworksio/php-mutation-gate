#!/usr/bin/env php
<?php

declare(strict_types=1);

// A warm worker of a Pest run (ADR-0023), which Pest's parent process starts
// on its own PHP, in its own directory, with the directory the run's workers
// share, the worker's place and the parent's process id, in that order. It
// starts only where PHP has pcntl and posix, loads the gate's own classes
// alone, runs with opcache off unless its directory holds what opcache keeps out, every file the run mutates
// among it (ADR-0088), and serves from a process of its own, which the system takes on once
// the one Pest started ends, as it does once the worker has written its
// process id, so a worker that ends is reaped and seen gone. Each child it forks takes on its run's
// environment, and no other variable, its directory and command line, with
// `$_ENV` filled as PHP fills it at start-up, is handed the worker's baseline
// of its test databases, and runs Pest's script as a fresh process runs it.

use NightWorksIO\MutationGate\Adapter\Native\Warm\BootCheck;
use NightWorksIO\MutationGate\Adapter\Pest\GateVariable;
use NightWorksIO\MutationGate\Adapter\Pest\Schemata;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Booted;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\BootSpec;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Database\Baseline;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Database\WarmDatabase;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Forking;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\GateClasses;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\OpcacheBlacklist;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\PestBoot;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Request;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Seat;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Wake;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Worker;
use NightWorksIO\MutationGate\Adapter\Runtime\ForkedChild;
use NightWorksIO\MutationGate\Core\NotGiven;
use NightWorksIO\MutationGate\Core\Runner\Polling;
use NightWorksIO\MutationGate\Core\Time\Seconds;
use Pest\Kernel;
use Pest\TestSuite;
use PHPUnit\Event\Facade;
use PHPUnit\TextUI\Configuration\PhpHandler;
use PHPUnit\TextUI\RuntimeException as TextUiRuntimeException;
use PHPUnit\TextUI\TestDirectoryNotFoundException;
use PHPUnit\TextUI\TestFileNotFoundException;
use PHPUnit\TextUI\XmlConfiguration\Exception as XmlConfigurationException;
use PHPUnit\TextUI\XmlConfiguration\Loader;
use PHPUnit\TextUI\XmlConfiguration\TestSuiteMapper;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Console\Output\ConsoleOutput;

require sprintf('%s/src/Adapter/Pest/Warm/GateClasses.php', dirname(__DIR__));

GateClasses::register(sprintf('%s/src', dirname(__DIR__)));

$given = is_array($_SERVER['argv']) ? $_SERVER['argv'] : [];
$arguments = [];

foreach ($given as $argument) {
    $arguments[] = is_string($argument) ? $argument : '';
}

[, $directory, $place, $parent] = [...$arguments, '', '', '', ''];

if (! function_exists('pcntl_fork') || ! function_exists('posix_kill')) {
    exit(1);
}

if (! OpcacheBlacklist::isIn($directory)) {
    ini_set('opcache.enable', '0');
}

$own = pcntl_fork();
$seat = Seat::at($directory, (int) $place);

if ($own !== 0) {
    $wait = getenv(GateVariable::WorkerWait->value);
    Polling::wait(
        Seconds::of(is_string($wait) && is_numeric($wait) ? (float) $wait : Seat::WAIT),
        static fn(): bool => is_file($seat->pid()),
        usleep(...),
    );

    exit($own !== -1 && is_file($seat->pid()) ? 0 : 1);
}

// Once a second, the worker ends where its run's directory or the process that started the run is gone,
// whatever Worker does, so no worker outlives its run, even one a mutant of Worker keeps serving.
pcntl_async_signals(enable: true);
pcntl_signal(SIGALRM, static function () use ($directory, $parent): void {
    if (! is_dir($directory) || (int) $parent < 2 || posix_getpgid((int) $parent) === false) {
        exit(0);
    }

    pcntl_alarm(1);
});
pcntl_alarm(1);
Wake::heard();

$boot = static function () use ($directory): string {
    $spec = BootSpec::readIn($directory);

    if (! $spec instanceof BootSpec) {
        return '';
    }

    $reading = PestBoot::of($spec);
    $config = $reading->config();

    if ($config instanceof NotGiven) {
        return $reading->unconfigured();
    }

    $held = BootCheck::open();
    $_SERVER['COLLISION_PRINTER'] = 'DefaultPrinter';
    $_SERVER['argv'] = [$spec->script()];
    $_SERVER['argc'] = 1;
    chdir($spec->root());

    require_once $spec->autoloader();

    Booted::booting();

    if ($spec->isForMutants()) {
        Booted::leavingPlugins();
        Schemata::servedIn($directory);
    }

    Kernel::boot(
        TestSuite::getInstance($spec->root(), 'tests'),
        new ArgvInput([$spec->script()]),
        new ConsoleOutput(),
    );
    try {
        $xml = new Loader(Facade::emitter())->load($config);
        $refused = $reading->refusal($xml);

        if ($refused === '') {
            $suites = $reading->suites($xml);
            new PhpHandler(Facade::emitter())->handle($xml->php());

            foreach ($reading->bootstraps($xml, $suites) as $bootstrap) {
                require_once $bootstrap;
            }

            if (! $spec->isForMutants()) {
                new TestSuiteMapper(Facade::emitter())->map($config, $xml->testSuite(), $suites, []);
            }
        }
    } catch (XmlConfigurationException|TextUiRuntimeException|TestDirectoryNotFoundException|TestFileNotFoundException $unread) {
        $refused = $reading->unread($config, $unread->getMessage());
    }

    return $refused !== '' ? $refused : $reading->leftOpen(BootCheck::open() - $held);
};

class_exists(WarmDatabase::class);

exit(Worker::at($directory, (int) $place, (int) $parent, Wake::paused(...))->booting($boot)->served(new class implements Forking {
    public function forked(Request $request, Baseline|NotGiven $baseline, string $report): int|NotGiven
    {
        $child = pcntl_fork();

        if ($child === -1) {
            return NotGiven::value();
        }

        if ($child !== 0) {
            return $child;
        }

        ForkedChild::reseeded();
        if (class_exists(Booted::class, autoload: false)) {
            Booted::forked();
        }

        pcntl_alarm(0);
        pcntl_signal(SIGALRM, SIG_DFL);
        Wake::unheard();

        $environment = $request->environment();

        foreach (array_keys(array_diff_key(getenv(), $environment)) as $stale) {
            putenv($stale);
            unset($_SERVER[$stale]);
        }

        foreach ($environment as $name => $value) {
            putenv(sprintf('%s=%s', $name, $value));
            $_SERVER[$name] = $value;
        }

        $_ENV = str_contains((string) ini_get('variables_order'), 'E') ? $environment : [];

        chdir($request->directory());
        $script = implode('', array_slice($request->argv(), 0, 1));
        $_SERVER['argv'] = $request->argv();
        $_SERVER['argc'] = count($request->argv());
        $_SERVER['SCRIPT_NAME'] = $script;
        $_SERVER['SCRIPT_FILENAME'] = $script;
        $_SERVER['PHP_SELF'] = $script;
        WarmDatabase::handed($baseline, $report);

        require $script;

        exit(0);
    }
}));
