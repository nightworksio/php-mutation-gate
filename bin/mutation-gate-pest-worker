#!/usr/bin/env php
<?php

declare(strict_types=1);

// A warm worker of a Pest run (ADR-0023), which Pest's parent process starts
// on its own PHP, in its own directory, with the directory the run's workers
// share, the worker's place and the parent's process id, in that order. It
// starts only where PHP has pcntl and posix, loads the gate's own classes
// alone, and serves from a process of its own, which the system takes on once
// the one Pest started ends, as it does once the worker has written its
// process id, so a worker that ends is reaped and seen gone. Each child it forks takes on its run's
// environment, and no other variable, its directory and command line, with
// `$_ENV` filled as PHP fills it at start-up, is handed the worker's baseline
// of its test databases, and runs Pest's script as a fresh process runs it.

use NightWorksIO\MutationGate\Adapter\Pest\Warm\Database\Baseline;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Database\WarmDatabase;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Forking;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\GateClasses;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Request;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Seat;
use NightWorksIO\MutationGate\Adapter\Pest\Warm\Worker;
use NightWorksIO\MutationGate\Core\NotGiven;
use NightWorksIO\MutationGate\Core\Runner\Polling;
use NightWorksIO\MutationGate\Core\Time\Seconds;

require sprintf('%s/src/Adapter/Pest/Warm/GateClasses.php', dirname(__DIR__));

GateClasses::register(sprintf('%s/src', dirname(__DIR__)));

$given = is_array($_SERVER['argv']) ? $_SERVER['argv'] : [];
$arguments = [];

foreach ($given as $argument) {
    $arguments[] = is_string($argument) ? $argument : '';
}

[, $directory, $place, $parent] = [...$arguments, '', '', '', ''];

if (! function_exists('pcntl_fork') || ! function_exists('posix_kill')) {
    exit(1);
}

ini_set('opcache.enable', '0');

$own = pcntl_fork();
$seat = Seat::at($directory, (int) $place);

if ($own !== 0) {
    Polling::wait(Seconds::of(Seat::WAIT), static fn(): bool => is_file($seat->pid()), usleep(...));

    exit($own !== -1 && is_file($seat->pid()) ? 0 : 1);
}

// Once a second, the worker ends where its run's directory or the process that started the run is gone,
// whatever Worker does, so no worker outlives its run, even one a mutant of Worker keeps serving.
pcntl_async_signals(enable: true);
pcntl_signal(SIGALRM, static function () use ($directory, $parent): void {
    if (! is_dir($directory) || (int) $parent < 2 || posix_getpgid((int) $parent) === false) {
        exit(0);
    }

    pcntl_alarm(1);
});
pcntl_alarm(1);

exit(Worker::at($directory, (int) $place, (int) $parent, usleep(...))->served(new class implements Forking {
    public function forked(Request $request, Baseline|NotGiven $baseline, string $report): int|NotGiven
    {
        $child = pcntl_fork();

        if ($child === -1) {
            return NotGiven::value();
        }

        if ($child !== 0) {
            return $child;
        }

        pcntl_alarm(0);
        pcntl_signal(SIGALRM, SIG_DFL);

        $environment = $request->environment();

        foreach (array_keys(array_diff_key(getenv(), $environment)) as $stale) {
            putenv($stale);
            unset($_SERVER[$stale]);
        }

        foreach ($environment as $name => $value) {
            putenv(sprintf('%s=%s', $name, $value));
            $_SERVER[$name] = $value;
        }

        $_ENV = str_contains((string) ini_get('variables_order'), 'E') ? $environment : [];

        chdir($request->directory());
        $script = implode('', array_slice($request->argv(), 0, 1));
        $_SERVER['argv'] = $request->argv();
        $_SERVER['argc'] = count($request->argv());
        $_SERVER['SCRIPT_NAME'] = $script;
        $_SERVER['SCRIPT_FILENAME'] = $script;
        $_SERVER['PHP_SELF'] = $script;
        WarmDatabase::handed($baseline, $report);

        require $script;

        exit(0);
    }
}));
