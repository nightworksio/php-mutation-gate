includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/ergebnis/phpstan-rules/rules.neon
    - vendor/tomasvotruba/type-coverage/config/extension.neon
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    # S1 — the four bundles the package ships. A conflict with this codebase is
    # scoped with `allowIn` below, never ignored.
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-non-timing-safe-calls.neon
    - vendor/shipmonk/phpstan-rules/rules.neon

parameters:
    level: max
    tmpDir: .phpstan-cache
    # R3 — the same trees rector.php and the Arch suite read, and the executable.
    paths:
        - src
        - plugins
        - tests
        - phpstan
        - bin/mutation-gate

    # The runner contract suite's fixture is a project of its own, with its own
    # dependencies, written as a user's library is rather than to these rules.
    # The static checker's fixture holds mutants, which are wrong on purpose.
    excludePaths:
        analyseAndScan:
            - tests/Contract/Runner/fixture
            - tests/Contract/Runner/infection-fixture
            - tests/Contract/Runner/phpunit-fixture
            - tests/Contract/StaticChecker/fixture

    # Pest's own annotation, corrected. See the stub.
    stubFiles:
        - phpstan/TestCall.stub

    # There is no `ignoreErrors` and no baseline. A rule that is wrong somewhere
    # is scoped with `allowIn`, which names where it does not apply.
    reportUnmatchedIgnoredErrors: true
    checkUninitializedProperties: true
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    reportAnyTypeWideningInVarTag: true

    # D3 — nothing untyped anywhere.
    type_coverage:
        declare: 100
        return_type: 100
        param_type: 100
        property_type: 100
        constant_type: 100

    # H3 — the complexity half; NoManyMethodsRule is the other.
    cognitive_complexity:
        class: 30
        function: 8

    # Every Pest test body is a closure, so a checked exception thrown in one is
    # reported as thrown inside a callable. These are thrown only when a test's
    # own harness is misused: a class name that does not exist handed to
    # reflection, or a process asked for output it was not started for.
    exceptions:
        uncheckedExceptionClasses:
            - ReflectionException
            - Symfony\Component\Process\Exception\LogicException
            - Symfony\Component\Process\Exception\ProcessSignaledException
            - Symfony\Component\Process\Exception\ProcessTimedOutException
            - Symfony\Component\Process\Exception\RuntimeException
            # A floor or a score out of range is a mistake in the code that
            # built it, never something a caller can answer.
            - NightWorksIO\MutationGate\Core\Score\NotAPercentage
            # A file the gate wrote that does not hold its shape is refused inside
            # the codec that reads it, and answered at the codec's edge.
            - NightWorksIO\MutationGate\Core\Format\NotInShape
            # A mutator that names itself wrongly, or a test that hands the
            # testing kit code that is not PHP, is a mistake in that code.
            - NightWorksIO\MutationGate\Mutator\NotAMutatorName
            - NightWorksIO\MutationGate\Mutator\Testing\NotParsed
            # A setting read as a type its definition does not make is a
            # mistake in the code that asked.
            - NightWorksIO\MutationGate\Core\Config\Definition\MisreadSetting
            # An option read that the command does not define is a mistake in the
            # code that reads it, never something a caller can answer.
            - Symfony\Component\Console\Exception\InvalidArgumentException

    # D11 is this repository's own rule, which scopes its one exemption with allowIn.
    shipmonkRules:
        enforceReadonlyPublicProperty:
            enabled: false

    ergebnis:
        # C4 is ergebnis's NoErrorSuppressionRule and the `switch` half of C5 is
        # its NoSwitchRule, both under `allRules`.
        allRules: true
        noExtends:
            classesAllowedToBeExtended:
                - InvalidArgumentException
                - RuntimeException
                - LogicException
                # php-parser's own base of a visitor, which the mutation engine
                # extends to put a change in place, as a bridge does.
                - PhpParser\NodeVisitorAbstract
                # Symfony's console streams, whose doWrite every line passes
                # through once formatted: the one place a line can be made
                # inert for a CI runner's log (Adapter\Console\InertOutput).
                - Symfony\Component\Console\Output\ConsoleOutput
                - Symfony\Component\Console\Output\StreamOutput
        # A named argument is how a call site says which of two strings is which.
        noNamedArgument:
            enabled: false
        noConstructorParameterWithDefaultValue:
            enabled: false

    # -----------------------------------------------------------------------
    # The layers, enforced at the call site (ARCHITECTURE.md A, B, C, P, Q, L).
    #
    # Core, Port, Config and Extension perform no I/O. Adapter and Cli do, and
    # every entry below that allows a call names them and nothing wider.
    # `allowIn` paths are fnmatch patterns resolved against `filesRootDir`.
    # -----------------------------------------------------------------------
    filesRootDir: %rootDir%/../../..

    disallowedFunctionCalls:
        # --- B1: time arrives through Psr\Clock\ClockInterface ------------------
        -
            function:
                - 'time()'
                - 'microtime()'
                - 'hrtime()'
                - 'date()'
                - 'gmdate()'
                - 'mktime()'
                - 'gmmktime()'
                - 'strtotime()'
                - 'getdate()'
                - 'localtime()'
                - 'gettimeofday()'
                - 'idate()'
                - 'date_create()'
                - 'date_create_immutable()'
            message: "B1 — time is an input, and the core reads it through Psr\\Clock\\ClockInterface so a test can pin it. Only an adapter or the CLI reads the system clock (B1)."
            allowIn:
                - src/Adapter/*
                - src/Cli/*
                - tests/*

        # --- B2: randomness is an input too ------------------------------------
        -
            function:
                - 'random_int()'
                - 'random_bytes()'
                - 'rand()'
                - 'mt_rand()'
                - 'srand()'
                - 'mt_srand()'
                - 'shuffle()'
                - 'str_shuffle()'
                - 'array_rand()'
                - 'uniqid()'
                - 'lcg_value()'
                - 'mt_getrandmax()'
            message: "B2 — randomness is a hidden input, and a plan cut from it differs between two runners that must cut the same shards. Nothing in src draws a random number (B2)."
            allowIn:
                - tests/*

        # --- B3: the filesystem belongs to an adapter ---------------------------
        -
            function:
                - 'file_get_contents()'
                - 'file_put_contents()'
                - 'fopen()'
                - 'fwrite()'
                - 'fread()'
                - 'fclose()'
                - 'fputs()'
                - 'fgets()'
                - 'fgetc()'
                - 'fgetcsv()'
                - 'fputcsv()'
                - 'unlink()'
                - 'mkdir()'
                - 'rmdir()'
                - 'rename()'
                - 'copy()'
                - 'touch()'
                - 'chmod()'
                - 'symlink()'
                - 'link()'
                - 'tempnam()'
                - 'tmpfile()'
                - 'file_exists()'
                - 'is_file()'
                - 'is_dir()'
                - 'is_readable()'
                - 'is_writable()'
                - 'filesize()'
                - 'filemtime()'
                - 'realpath()'
                - 'scandir()'
                - 'glob()'
                - 'opendir()'
                - 'readdir()'
                - 'closedir()'
                - 'file()'
                - 'readfile()'
                - 'sys_get_temp_dir()'
                - 'getcwd()'
                - 'chdir()'
                - 'simplexml_load_file()'
                - 'parse_ini_file()'
            message: "B3 — the filesystem belongs to an adapter. A decision that reads a file cannot be tested without one, so the core is handed what the file says through a port (B3)."
            allowIn:
                - bin/*
                - src/Adapter/*
                - src/Cli/*
                - tests/*
                - phpstan/*

        # --- B4: running a program belongs to an adapter ------------------------
        -
            function:
                - 'exec()'
                - 'shell_exec()'
                - 'passthru()'
                - 'system()'
                - 'proc_open()'
                - 'popen()'
                - 'pcntl_exec()'
            message: "B4 — running a program is an adapter's job: the runner adapters run Pest and Infection, and the git adapter runs git. The core asks them through a port (B4, S1)."
            allowIn:
                - src/Adapter/*
                - tests/*

        # --- B5: the network belongs to an adapter ------------------------------
        -
            function:
                - 'curl_init()'
                - 'curl_exec()'
                - 'curl_setopt()'
                - 'curl_setopt_array()'
                - 'curl_multi_init()'
                - 'fsockopen()'
                - 'pfsockopen()'
                - 'stream_socket_client()'
                - 'stream_context_create()'
                - 'socket_create()'
                - 'get_headers()'
            message: "B5 — the network belongs to an adapter: a proof store in a bucket, a comment on a pull request. The core is handed the answer (B5)."
            allowIn:
                - src/Adapter/*

        # --- B6: the environment is read once, at the edge -----------------------
        -
            function:
                - 'getenv()'
                - 'putenv()'
                - 'apache_getenv()'
            message: "B6 — the environment is an input. The CLI and the adapters read it and hand the core a value; a core that read it would decide differently on two machines with the same config (B6)."
            allowIn:
                - src/Adapter/*
                - src/Cli/*
                - tests/*

        # --- B7: waiting is an adapter's -----------------------------------------
        -
            function:
                - 'sleep()'
                - 'usleep()'
                - 'time_nanosleep()'
                - 'time_sleep_until()'
            message: "B7 — waiting blocks the one process that plans and judges, and a test that sleeps is slow and still flaky. Only an adapter polling something outside waits (B7)."
            allowIn:
                - src/Adapter/*

        # --- P3: a method's parameters are its signature --------------------------
        -
            function: 'func_get_args()'
            message: "P3 — func_get_args() takes arguments the signature does not declare, so no call site can be checked. Declare the parameters (P3)."

        # --- Q1: nothing reconfigures the runtime -------------------------------
        -
            function:
                - 'ini_set()'
                - 'ini_alter()'
                - 'ini_restore()'
                - 'error_reporting()'
                - 'set_error_handler()'
                - 'set_exception_handler()'
                - 'restore_error_handler()'
                - 'date_default_timezone_set()'
                - 'setlocale()'
                - 'set_time_limit()'
                - 'assert_options()'
                - 'mb_internal_encoding()'
                - 'mb_regex_encoding()'
                - 'iconv_set_encoding()'
            message: "Q1 — the gate runs inside somebody else's process when a test boots it, and a setting changed here stays changed for them. Pass the value where it is needed (Q1)."
            allowIn:
                - tests/*
                # The command, and no library code, gives its own process the memory its ledgers may need.
                - bin/mutation-gate
                # zlib raises a broken stream as a warning as well as answering false; the handler that keeps the
                # warning from the run's output is restored before inflate_add's answer is returned.
                - src/Core/Format/Gzip.php

        # --- L3: bytes are not characters -----------------------------------------
        -
            function:
                - 'strlen()'
                - 'substr()'
                - 'strtoupper()'
                - 'strtolower()'
                - 'ucfirst()'
                - 'lcfirst()'
                - 'str_pad()'
                - 'str_split()'
                - 'strpos()'
                - 'strrpos()'
                - 'stripos()'
                - 'strripos()'
                - 'strstr()'
                - 'stristr()'
                - 'strrchr()'
                - 'strrev()'
                - 'ucwords()'
                - 'wordwrap()'
                - 'substr_count()'
                - 'substr_replace()'
                - 'str_word_count()'
            message: "L3 — a path, a test name or a message is text, and a byte function splits a multibyte character in half. Use the mb_* equivalent (L3)."
            allowIn:
                - tests/*
                - phpstan/*

    disallowedNamespaces:
        # --- B1: the clock, as a type --------------------------------------------
        -
            class:
                - 'DateTime'
                - 'DateTimeImmutable'
            allowInParamTypes: true
            allowInReturnType: true
            allowInUse: true
            message: "B1 — a DateTimeImmutable built with no argument reads the system clock. Take the instant from Psr\\Clock\\ClockInterface (B1)."
            allowIn:
                - src/Adapter/*
                - src/Cli/*
                - tests/*

        # --- B4: Symfony Process runs a program ----------------------------------
        -
            class: 'Symfony\Component\Process\*'
            message: "B4 — running a program is an adapter's job; the core asks through a port (B4)."
            allowIn:
                - src/Adapter/*
                - tests/*

        # --- P4: reflection is the analyser's blind spot -------------------------
        -
            class:
                - 'Reflection*'
            message: "P4 — a member reached by name is one no rule can find. The tests reflect on purpose, to ask PHP what the analyser cannot (P4)."
            allowIn:
                - tests/*
                - phpstan/*
                # Pest's filter reads #[Holds] from the closures Pest hands it (ADR-0004).
                - src/Adapter/Pest/Grouping/HoldsGroups.php
                # The plugin names each test from the class Pest built for it (ADR-0014).
                - src/Adapter/Pest/Recording/Naming.php

    disallowedSuperglobals:
        # --- B6: the environment, read the other way -----------------------------
        -
            superglobal:
                - '$_GET'
                - '$_POST'
                - '$_REQUEST'
                - '$_SERVER'
                - '$_ENV'
                - '$_COOKIE'
                - '$_SESSION'
                - '$_FILES'
                - '$GLOBALS'
            message: "B6 — the environment is an input, read once by the CLI and handed on as a value (B6)."
            allowIn:
                - bin/*
                - src/Cli/*
                - tests/*

    disallowedConstants:
        # --- B3: the standard streams are files ----------------------------------
        -
            constant:
                - 'STDIN'
                - 'STDOUT'
                - 'STDERR'
            message: "B3 — the standard streams belong to the CLI and the reporters that write to them (B3, Q4)."
            allowIn:
                - src/Adapter/*
                - src/Cli/*
                - tests/*

    disallowedAttributes:
        -
            attribute: 'AllowDynamicProperties'
            message: "P3 — a class's properties are declared. A dynamic property cannot be typed and turns a typo into a new field (P3)."

    disallowedControlStructures:
        # --- C5: no `else` ---------------------------------------------------------
        -
            controlStructure:
                - 'else'
                - 'elseif'
            message: "C5 — no `else`. Return from the condition that refuses and let the rest carry on at one indent; where both branches are answers, write a match (C5)."

    disallowedMethodCalls:
        # --- C3: an exception says which refusal it is ------------------------------
        -
            method:
                - 'Exception::__construct()'
                - 'RuntimeException::__construct()'
                - 'LogicException::__construct()'
                - 'InvalidArgumentException::__construct()'
                - 'DomainException::__construct()'
                - 'UnexpectedValueException::__construct()'
                - 'ErrorException::__construct()'
            allowIn:
                - tests/*
                - phpstan/*
            allowInInstanceOf:
                - 'Throwable'
            message: "C3 — a bare exception tells a catch block nothing it can act on. Name the refusal with a class of this package's own, and across a port answer with an outcome instead (C3, C1)."

services:
    # C6
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoBroadCatchRule
        tags:
            - phpstan.rules.rule
    # C7
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoEmptyRule
        tags:
            - phpstan.rules.rule
    # C8
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoNullsafeInCoreRule
        tags:
            - phpstan.rules.rule
    # C9
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoNestedTernaryRule
        tags:
            - phpstan.rules.rule
    # D5
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoPositionalBooleanArgumentRule
        tags:
            - phpstan.rules.rule
    # D10, with the decoders of untrusted input, the classes whose signatures a
    # PHP protocol fixes, and the files that still hold a mixed to type, a list
    # that only shrinks.
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoMixedOutsideDecodersRule
        arguments:
            protocols:
                - src/Adapter/PhpUnit/MutantFile.php # PHP hands a stream wrapper resources, which have no native type
            decoders:
                - src/Core/Format/Node.php
                - src/Core/Format/Json.php
                - src/Core/Format/JsonText.php
                - src/Core/Config/Parsed.php
                - src/Adapter/Php/PhpConfig.php
                - src/Cli/CommandLine.php
                - src/Adapter/Infection/RelaxedJson.php
                - tests/Support/Bucket.php
                - tests/Support/Commands.php
                - tests/Support/CountingClient.php # Symfony's HttpClientInterface takes request options untyped
                - tests/Support/PhpstanNeon.php
            allowIn:
                - src/Adapter/GitHub/Answer.php
                - src/Adapter/GitLab/GitLabPlan.php
                - tests/Support/Configs.php
                - tests/Support/Decoded.php
                - tests/Support/InfectionRun.php
        tags:
            - phpstan.rules.rule
    # D8, with the files that translate an outside vocabulary into the gate's
    # own enum at the boundary.
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoStringClosedSetRule
        arguments:
            # Outside vocabularies, translated into the gate's own at the boundary.
            vocabularyIn:
                - src/Adapter/Git/Diff.php # git's status letters
                - src/Adapter/Infection/Families.php # Infection's mutator names
                - src/Adapter/Infection/OwnConfig.php # infection.json's sections
                - src/Adapter/Pest/Families.php # Pest's mutator names
                - src/Core/Runner/Opcache.php # PHP's ini switches, as the Pest plugin and doctor's probe read them
                - src/Core/File/Glob.php # the glob grammar
                - src/Core/Assertion/AssertionTable.php # PHPUnit's assertions and Pest's expectations
            # Closed sets still to become enums, by the builder whose area holds them.
            awaiting:
                - src/Adapter/GitHub/GitHubPlan.php # owner: flows (a GitHubEvent enum)
        tags:
            - phpstan.rules.rule
    # D9, with the constants whose value only coincides with another's.
    -
        class: NightWorksIO\MutationGate\PHPStan\Collectors\ConstantValues
        tags:
            - phpstan.collector
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\OneHomePerValueRule
        arguments:
            # Constants whose value only coincides with another's, meaning something else.
            coincidences:
                'NightWorksIO\MutationGate\Core\Cost\StartUpSamples':
                    - STANDARD # runs of no test the plan times
                'NightWorksIO\MutationGate\Core\Runner\MemoryUnit':
                    - KILO # bytes in a kilobyte, as PHP counts one
                'NightWorksIO\MutationGate\Core\Troubleshooting\Guide':
                    - UNRELEASED # the package's own branch, in a link to its guide
                'NightWorksIO\MutationGate\Core\Php\OwnMember':
                    - PARENT # PHP's keyword, not php-parser's attribute
                'NightWorksIO\MutationGate\Core\Assertion\AssertionScan':
                    - CALL_OPENS # tokens from what a link is chained to, to its call's bracket
                'NightWorksIO\MutationGate\Adapter\GitHub\PullRequestComment':
                    - PAGE # comments a page
                    - PAGES # pages read
                'NightWorksIO\MutationGate\Adapter\Alert\Delivery':
                    - TIMEOUT # seconds a post may take
                    - LONGEST_WAIT # seconds a Retry-After is waited
                'NightWorksIO\MutationGate\Core\Http\Reply':
                    - SERVER # an HTTP status
                    - REDIRECT # an HTTP status
                    - ANSWER # characters of an answer repeated
                'NightWorksIO\MutationGate\Adapter\GitHub\Markdown':
                    - COMMENTED # entries a comment's list holds
                'NightWorksIO\MutationGate\Core\Alert\AlertLines':
                    - SURVIVORS # survivors an alert names
                'NightWorksIO\MutationGate\Core\Alert\DiscordMessage':
                    - TITLE # characters Discord shows of a title
                'NightWorksIO\MutationGate\Core\Config\Shards':
                    - MOST # shards
                'NightWorksIO\MutationGate\Core\Config\Triage':
                    - RETRIES # retries
                    - TIMEOUT # seconds a mutant may run
                'NightWorksIO\MutationGate\Core\Config\Canonical':
                    - EACH # how a list's entries are named in a setting's path
                'NightWorksIO\MutationGate\Core\Config\Proofs':
                    - PATH # the directory store's option
                'NightWorksIO\MutationGate\Core\Config\StaticCheck':
                    - AUTO # the analyser zero-config finds, not a proof-writing mode
                    - NONE # no analyser, not a mutator family or a Pest status
                'NightWorksIO\MutationGate\Core\Format\Bytes':
                    - PER_MEGABYTE # bytes in a megabyte
                    - PER_MEBIBYTE # bytes in PHP's M, not GitHub's summary cap
                'NightWorksIO\MutationGate\Core\Proof\LedgerMemory':
                    - PER_BYTE # bytes of memory per byte of ledger
                'NightWorksIO\MutationGate\Adapter\Infection\OwnConfig':
                    - FRAMEWORK # Infection's name for PHPUnit
                'NightWorksIO\MutationGate\Core\Test\TestsDirectory':
                    - CONVENTIONAL # the tests' directory
                'NightWorksIO\MutationGate\Core\Hold\HotPaths':
                    - SMALLEST_SUITE # tests
                'NightWorksIO\MutationGate\Adapter\GitLab\GitLabPlan':
                    - HIDDEN_JOB # a job name
                'NightWorksIO\MutationGate\Adapter\Filesystem\Resources':
                    - PACKAGE_ROOT # directories up to the package
                'NightWorksIO\MutationGate\Core\Hint\Hint':
                    - NAMED # names a hint gives
                'NightWorksIO\MutationGate\Adapter\GitHub\Annotations':
                    - PER_LEVEL # annotations GitHub shows
                'NightWorksIO\MutationGate\Adapter\Pest\PestTimeLimit':
                    - EXTRA_SHARE # a share of Pest's opening time
                    - LEAST_EXTRA # Pest's least extra time
                'NightWorksIO\MutationGate\Adapter\Infection\Limits':
                    - BOOTSTRAP # Infection's bootstrap time
                    - FACTOR # Infection's timeout factor
                'NightWorksIO\MutationGate\Core\Proof\LedgerRetention':
                    - BASES # bases kept
                    - PROOFS # proofs kept
                'NightWorksIO\MutationGate\Adapter\Yaml\YamlConfig':
                    - INDENT # spaces
                    - NESTED # levels
                'NightWorksIO\MutationGate\Adapter\Neon\NeonConfig':
                    - INDENT # a NEON indent
                'NightWorksIO\MutationGate\Adapter\Pest\Diff':
                    - INDENT # a line of Pest's diff
                'NightWorksIO\MutationGate\Adapter\PhpUnit\MutantFile':
                    - PROTOCOL # the file:// stream protocol
                'NightWorksIO\MutationGateDefault\Literals':
                    - 'TRUE' # PHP's constant, not Infection's setting
                'NightWorksIO\MutationGateDefault\Calls':
                    - VALUE # the name of a parameter the mutant's code declares
                'NightWorksIO\MutationGate\Core\Proof\LedgerFile':
                    - FORMAT # a format version
                    - UNDIGESTED # a format version
                    - SECONDS # a field of the ledger
                    - RUNNER # a field of the ledger
                    - TESTS # a field of the ledger
                    - PASSED # a field of the ledger
                'NightWorksIO\MutationGate\Core\Analysis\RejectionLength':
                    - CODE # characters of a recorded rejection's code
                'NightWorksIO\MutationGate\Core\Proof\AnalysersRecord':
                    - SECONDS # a field of the ledger's analysers section
                    - MUTATORS # a field of the ledger's analysers section
                'NightWorksIO\MutationGate\Cli\Flow\SurvivorChecking':
                    - WITH_ITS_PRINT # the checks a printed file's first survivor needs
                'NightWorksIO\MutationGate\Core\Plan\SurvivorChecksRecord':
                    - FILE # a field of a shard result
                'NightWorksIO\MutationGate\Core\Analysis\SurvivorChecks':
                    - NAMED # how many files a warning of unchecked survivors names
                'NightWorksIO\MutationGate\Core\Mutant\DiffPatch':
                    - NO_NEWLINE # a unified diff's note on a missing line break
                'NightWorksIO\MutationGate\Core\Mutant\MutantRecord':
                    - SECONDS # a field of a shard result
                    - MUTATOR # a field of a shard result
                    - ID # a field of a shard result
                    - STATUS # a field of a shard result
                    - END # a field of a shard result
                    - DIFF # a field of a shard result
                'NightWorksIO\MutationGate\Adapter\Infection\Results':
                    - KILLED_BY_TESTS # a list of Infection's log
                    - MUTATOR # a field of Infection's log
                'NightWorksIO\MutationGate\Adapter\Pest\Recording\Naming':
                    - PREFIX # PHPUnit's prefix of a test method
                'NightWorksIO\MutationGate\Core\Php\Codebase':
                    - STEPS # declarations followed
                'NightWorksIO\MutationGate\Core\Php\StaticReads':
                    - ARGUMENT # tokens after a call's name
                    - CLOSE # tokens after a call's name
                'NightWorksIO\MutationGate\Adapter\Infection\Setup':
                    - TESTS # a key of the runner's options
                'NightWorksIO\MutationGate\Adapter\Pest\PestOptions':
                    - TESTS # a key of the runner's options
                'NightWorksIO\MutationGate\Adapter\Filesystem\ReportPath':
                    - KEY # a key of a report's entry
                'NightWorksIO\MutationGate\Core\Composer\Manifest':
                    - PATH # a kind of Composer repository
                    - REQUIRE # a key of a manifest
                'NightWorksIO\MutationGate\Core\Baseline\BaselineFile':
                    - FLOOR # a field of the baseline
                'NightWorksIO\MutationGate\Core\Test\TestNamesRecord':
                    - FILE # a field of the plan's test names
                'NightWorksIO\MutationGate\Core\Plan\EstimateRecord':
                    - OPENING # a field of a planned shard
                'NightWorksIO\MutationGate\Cli\Console':
                    - DEFAULT # the default command
                'NightWorksIO\MutationGate\Core\Report\Stryker':
                    - LANGUAGE # Stryker's name for the language
                'NightWorksIO\MutationGate\Core\Report\SavingsText':
                    - DAYS # days the savings count
                'NightWorksIO\MutationGate\Cli\Command\FlowOptions':
                    - COVERAGE # an option of the gate's commands
                    - FULL # an option of the gate's commands
                'NightWorksIO\MutationGate\Core\Ci\DefaultBranch':
                    - FALLBACK # the project's default branch when none is configured or detected
                'NightWorksIO\MutationGate\Core\Plan\PlanFile':
                    - BASE # a field of the plan
                    - PROVED # a field of the plan
                    - CARRIED # a field of the plan
                    - CHANGED # a field of the plan
                'NightWorksIO\MutationGate\Core\Plan\ShardResultFile':
                    - FLAKY # a field of a shard result
                    - UNJUDGED # a field of a shard result
                    - MEASURED # a field of a shard result
                'NightWorksIO\MutationGate\Core\Verdict\TimeoutTriage':
                    - HALVES # the halves of a limit
                'NightWorksIO\MutationGate\Core\Time\Budgets':
                    - PRE_PUSH_MINUTES # a budget, in minutes
                'NightWorksIO\MutationGate\Cli\Flow\Invoking':
                    - DOUBLED # a retried timeout's cap, doubled
            # Constants still to refer to their value's one home, by the builder whose area holds them.
            awaiting:
                'NightWorksIO\MutationGate\Core\Proof\Key\Exceptions':
                    - OWN # owner: flows (Workspace::root())
                'NightWorksIO\MutationGate\Adapter\GitHub\PassedPullRequests':
                    - API # owner: flows (Api::at() gives GitHub's own)
                'NightWorksIO\MutationGate\Cli\Console':
                    - NAME # owner: flows (ThisPackage::NAME)
                'NightWorksIO\MutationGate\Cli\FirstParty':
                    - PACKAGE # owner: flows (ThisPackage::COMPOSER)
                'NightWorksIO\MutationGate\Adapter\PhpUnit\Project':
                    - OWN # owner: phpunit runner (BuiltinRunner::PhpUnit)
        tags:
            - phpstan.rules.rule
    # D6
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoMagicNumberRule
        tags:
            - phpstan.rules.rule
    # H3, with the classes whose methods a PHP protocol fixes.
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoManyMethodsRule
        arguments:
            allowIn:
                - src/Adapter/PhpUnit/MutantFile.php # PHP's streamWrapper protocol
        tags:
            - phpstan.rules.rule
    # D11, in place of shipmonk's enforceReadonlyPublicProperty, with the files
    # whose public property PHP itself writes.
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\ReadonlyPublicPropertyRule
        arguments:
            allowIn:
                - src/Adapter/PhpUnit/MutantFile.php # PHP writes $context from global scope
        tags:
            - phpstan.rules.rule
    # H5, one class per node type
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\PreferSprintfOverConcatRule
        tags:
            - phpstan.rules.rule
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\PreferSprintfOverInterpolationRule
        tags:
            - phpstan.rules.rule
    # H8
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoManyReturnsRule
        tags:
            - phpstan.rules.rule
    # H10
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoLongLineRule
        tags:
            - phpstan.rules.rule
    # H11
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\LettersOnlyClassNameRule
        tags:
            - phpstan.rules.rule
    # H9
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\ListLayoutRule
        tags:
            - phpstan.rules.rule
    # P1
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoMagicMethodRule
        tags:
            - phpstan.rules.rule
    # P2, with the two files that construct a class by a name they read: the
    # extension classes the Composer manifests name (ADR-0001), and the
    # extensions and adapters a config names by class (ADR-0002).
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoDynamicAccessRule
        arguments:
            classNamedAtRuntimeIn:
                - src/Cli/Discovery/Discovery.php
                - src/Cli/Config/Chosen.php
                - src/Mutator/Engine/SetEngine.php
        tags:
            - phpstan.rules.rule
    # Q3
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoLateStaticBindingRule
        tags:
            - phpstan.rules.rule
    # Q4
    -
        class: NightWorksIO\MutationGate\PHPStan\Rules\NoOutputRule
        tags:
            - phpstan.rules.rule
