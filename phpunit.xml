<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnEmptyTestSuite="false"
         failOnPhpunitDeprecation="true"
         failOnPhpunitNotice="true"
         failOnPhpunitWarning="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutCoverageMetadata="false"
>
    <!-- G9 — a diagnostic fails the run. The `failOn*` attributes above and the
         `ignoreSuppressionOf*` attributes on `<source>` below are the two
         halves; TheSuiteCannotGoQuietTest keeps both. -->
    <testsuites>
        <!-- The rules first, so a broken boundary fails before anything slower. -->
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>

        <!-- One file per source file, mirroring src (H4). -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>

        <!-- The first-party plugins, each tested inside its own tree (A8). -->
        <testsuite name="Plugins">
            <directory>plugins/*/tests</directory>
        </testsuite>

        <!-- One suite per port, run against its fake and every adapter (G2).
             The runner suite's fixture is a project of its own, with a vendor
             directory whose files end in Test.php. -->
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
            <exclude>tests/Contract/Runner/fixture</exclude>
            <exclude>tests/Contract/Runner/infection-fixture</exclude>
            <exclude>tests/Contract/Runner/crash</exclude>
            <exclude>tests/Contract/Runner/reach</exclude>
            <exclude>tests/Contract/Runner/stall</exclude>
            <exclude>tests/Contract/Runner/override</exclude>
            <exclude>tests/Contract/Runner/interceptor</exclude>
            <exclude>tests/Contract/Runner/twins</exclude>
            <exclude>tests/Contract/Runner/phpunit-fixture</exclude>
            <exclude>tests/Contract/StaticChecker/fixture</exclude>
        </testsuite>

        <!-- The judgements of the rules in phpstan/Rules, each test file beside the
             file it tests, mirroring phpstan. -->
        <testsuite name="PHPStan">
            <directory>tests/PHPStan</directory>
        </testsuite>

        <!-- The documentation, held to the code it describes (ADR-0018). -->
        <testsuite name="Docs">
            <directory>tests/Docs</directory>
        </testsuite>

        <!-- R2, on its own: plants a violation of every rule in a throwaway copy
             of the tree and runs the analyser and the suite over it. -->
        <testsuite name="Guards">
            <directory>tests/Guards</directory>
        </testsuite>
    </testsuites>

    <!-- The guards that need the network or a whole covered run, which CI's
         guards job runs as a group of their own. -->
    <groups>
        <exclude>
            <group>ci-only</group>
        </exclude>
    </groups>

    <source
        ignoreSuppressionOfDeprecations="true"
        ignoreSuppressionOfPhpDeprecations="true"
        ignoreSuppressionOfErrors="true"
        ignoreSuppressionOfNotices="true"
        ignoreSuppressionOfPhpNotices="true"
        ignoreSuppressionOfWarnings="true"
        ignoreSuppressionOfPhpWarnings="true"
    >
        <include>
            <directory>src</directory>
            <directory>plugins/*/src</directory>
        </include>
    </source>
</phpunit>
