<?php

namespace pcov;

/**
 * pcov answers each file it collected with a mark for each line it reports, 1
 * where a test executed it and -1 where none did, for the files a filter names;
 * PHP's own stub leaves both untyped.
 *
 * @param  list<string>                   $filter
 * @return array<string, array<int, int>>
 */
function collect(int $type = 0, array $filter = []): array {}

/**
 * pcov answers the files loaded since it last collected, by their names.
 *
 * @return list<string>
 */
function waiting(): array {}
