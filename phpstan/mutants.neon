includes:
    - ../phpstan.neon

parameters:
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: mutationGate.longLine
        - identifier: mutationGate.listLayout
        - identifier: disallowed.class
          path: ../.mutation-gate/staticcheck/*
        - identifier: disallowed.constant
          path: ../.mutation-gate/staticcheck/*
        - identifier: disallowed.function
          path: ../.mutation-gate/staticcheck/*
        - identifier: disallowed.method
          path: ../.mutation-gate/staticcheck/*
        - identifier: disallowed.namespace
          path: ../.mutation-gate/staticcheck/*
        - identifier: disallowed.staticCall
          path: ../.mutation-gate/staticcheck/*
        - identifier: disallowed.variable
          path: ../.mutation-gate/staticcheck/*
        - identifier: mutationGate.dynamicAccess
          path: ../.mutation-gate/staticcheck/*
        - identifier: mutationGate.manyMethods
          path: ../.mutation-gate/staticcheck/*
        - identifier: mutationGate.publicPropertyNotReadonly
          path: ../.mutation-gate/staticcheck/*
