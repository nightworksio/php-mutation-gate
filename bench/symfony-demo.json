    "arms": {
        "infection": {
            "said": "plain Infection, unpatched, --threads=max, with a config of src and Infection's default mutators, as the demo has none of its own, a JSON and a text log added",
            "report": "infection",
            "clean": [
                "infection.txt",
                "bench-infection-log.json",
                "bench-infection.txt"
            ],
            "command": [
                "vendor/bin/infection",
                "--configuration=bench-plain-infection.json",
                "--threads=max",
                "--no-progress",
                "--no-interaction",
                "--log-verbosity=all",
                "--logger-text=bench-infection.txt"
            ],
            "log": "bench-infection-log.json",
            "text": "bench-infection.txt",
            "directory": "../symfony-demo-plain"
        },
        "gate-infection": {
            "said": "the gate in one job, mutating with Infection under infection:patch and that config's mutators",
            "report": "gate",
            "clean": [
                ".mutation-gate"
            ],
            "command": [
                "vendor/bin/mutation-gate",
                "run",
                "--no-interaction",
                "--config=bench-infection.json",
                "--report=json:{report}"
            ],
            "copy": {
                "mutation-gate.baseline.json": "bench-baseline.json"
            },
            "keep": [
                ".mutation-gate"
            ]
        },
        "gate-phpunit": {
            "said": "the gate in one job, mutating with its own engine and forked PHPUnit workers",
            "report": "gate",
            "clean": [
                ".mutation-gate"
            ],
            "command": [
                "vendor/bin/mutation-gate",
                "run",
                "--no-interaction",
                "--config=bench-phpunit.json",
                "--report=json:{report}"
            ],
            "copy": {
                "mutation-gate.baseline.json": "bench-baseline.json"
            },
            "keep": [
                ".mutation-gate"
            ]
        }
    },
    "same": [
        "infection",
        "gate-infection"
    ],
    "sharded": {
        "arm": "gate-infection",
        "said": "the gate-infection arm sharded at its shards.seconds, each shard on a machine of its own"
    },
