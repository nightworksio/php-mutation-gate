    "arms": {
        "infection": {
            "said": "plain Infection, unpatched, --threads=max, with the project's own infection.json.dist, a JSON and a text log added",
            "report": "infection",
            "clean": [
                "infection.txt",
                "bench-infection-log.json",
                "bench-infection.txt"
            ],
            "command": [
                "vendor/bin/infection",
                "--configuration=bench-plain-infection.json",
                "--threads=max",
                "--no-progress",
                "--no-interaction",
                "--log-verbosity=all",
                "--logger-text=bench-infection.txt"
            ],
            "log": "bench-infection-log.json",
            "text": "bench-infection.txt",
            "directory": "../jwt-plain"
        },
        "gate-infection": {
            "said": "the gate in one job, mutating with Infection under infection:patch and the project's own mutators and ignores",
            "report": "gate",
            "clean": [
                ".mutation-gate"
            ],
            "command": [
                "vendor/bin/mutation-gate",
                "run",
                "--no-interaction",
                "--config=bench-infection.json",
                "--report=json:{report}"
            ],
            "copy": {
                "mutation-gate.baseline.json": "bench-baseline.json"
            },
            "keep": [
                ".mutation-gate"
            ]
        },
        "gate-phpunit": {
            "said": "the gate in one job, mutating with its own engine and forked PHPUnit workers",
            "report": "gate",
            "clean": [
                ".mutation-gate"
            ],
            "command": [
                "vendor/bin/mutation-gate",
                "run",
                "--no-interaction",
                "--config=bench-phpunit.json",
                "--report=json:{report}"
            ],
            "copy": {
                "mutation-gate.baseline.json": "bench-baseline.json"
            },
            "keep": [
                ".mutation-gate"
            ]
        }
    },
    "same": [
        "infection",
        "gate-infection"
    ],
    "sharded": {
        "arm": "gate-infection",
        "said": "the gate-infection arm, sharded at the shards.seconds of its config"
    },
